# Python environments, bytecode, packaging, and tooling caches
__pycache__/
*.py[cod]
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/

# Test output and local execution evidence (curated evidence belongs in docs/)
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml
/reports/
/artifacts/
*.log
/logs/

# Local environment variables and credentials; retain sanitized examples
.env
.env.*
!.env.example
!.env.*.example
!.env.template
.envrc
.direnv/
/secrets/
/credentials/
.aws/
.kube/
.docker/
kubeconfig
kubeconfig.*
*.kubeconfig
!kubeconfig.example
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# OpenTofu/Terraform caches, state, plans, and local overrides
# Commit .terraform.lock.hcl to preserve provider version/checksum selections.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
crash.log
crash.*.log

# Ansible runtime files and local vault passwords
.ansible/
*.retry
.vault_pass
.vault_pass.*
.vault-password
.vault-password.*
vault-password.txt

# Helm dependencies/packages and local value overrides
# Commit Chart.lock and sanitized values files for reproducible deployment.
charts/**/charts/
charts/**/*.tgz
values.local.yaml
values.local.yml
values.secret.yaml
values.secret.yml
values.secrets.yaml
values.secrets.yml

# Minikube/QEMU artifacts and locally installed tooling
.minikube/
*.qcow2
*.qcow
*.img
*.iso
*.raw
/.tools/
/.local/
/tmp/
/temp/

# Runtime database files and backups; SQL migrations remain versioned
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
/data/
/backups/
/dumps/

# Local research, editor settings, and operating system files
.firecrawl/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
